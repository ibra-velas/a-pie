# Supabase — PostGIS database
# Get these from your Supabase project dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# OpenRouteService — walking isochrones
# Free tier: 2000 requests/day → https://openrouteservice.org/dev/#/signup
ORS_KEY=your-openrouteservice-api-key

# Direct Postgres connection (used by the Python ingestion script)
# Get the connection string from Supabase → Settings → Database
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
